#!/bin/bash
#SBATCH --job-name=build_seasplat
#SBATCH --output=/home/arua/thesis/logs/build_seasplat.%j.out
#SBATCH --error=/home/arua/thesis/logs/build_seasplat.%j.err
#SBATCH --nodes=1
#SBATCH --nodelist=cn7
#SBATCH --gres=gpu:a100_80gb:1
#SBATCH --partition=acltr
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=72:00:00

set -e
set -x

export TMPDIR=/home/arua/tmp

module load CUDA/12.1.1
module load GCCcore/12.3.0
module load Miniconda3/25.5.1-1

MINICONDA_ROOT=/opt/itu/easybuild/software/Miniconda3/25.5.1-1
ENV_PATH=/home/arua/thesis/envs/seasplat

source $MINICONDA_ROOT/etc/profile.d/conda.sh
conda activate $ENV_PATH

export CUDA_HOME=/opt/itu/easybuild/software/CUDA/12.1.1
export PATH=$CUDA_HOME/bin:$PATH
export LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH

cd /home/arua/thesis/code/seasplat_underwater

git submodule update --init --recursive

git rev-parse HEAD | tee /home/arua/thesis/code/seasplat_commit.txt
git log --oneline -5

pip install --no-build-isolation submodules/diff-gaussian-rasterization
pip install --no-build-isolation submodules/simple-knn

python3 -c "
import diff_gaussian_rasterization
import simple_knn
import torch
print('diff_gaussian_rasterization: OK')
print('simple_knn: OK')
print('GPU:', torch.cuda.get_device_name(0))
"

pip freeze > /home/arua/thesis/requirements_final.txt

echo "seasplat build done"
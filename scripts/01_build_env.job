#!/bin/bash
#SBATCH --job-name=build_env
#SBATCH --output=/home/arua/thesis/logs/build_env.out
#SBATCH --error=/home/arua/thesis/logs/build_env.err
#SBATCH --nodes=1
#SBATCH --nodelist=cn4
#SBATCH --gres=gpu:v100:1
#SBATCH --cpus-per-task=8
#SBATCH --time=04:00:00
#SBATCH --partition=acltr

set -e
set -x

mkdir -p /home/arua/thesis/logs

export TMPDIR=/home/arua/tmp
mkdir -p $TMPDIR

module load CUDA/12.1.1
module load GCCcore/12.3.0
module load Miniconda3/25.5.1-1

nvcc --version
gcc --version
nvidia-smi

export CONDA_PKGS_DIRS=/home/arua/CACHE_CONDA
mkdir -p $CONDA_PKGS_DIRS

MINICONDA_ROOT=/opt/itu/easybuild/software/Miniconda3/25.5.1-1
ENV_PATH=/home/arua/thesis/envs/seasplat

$MINICONDA_ROOT/bin/conda tos accept --override-channels \
    --channel https://repo.anaconda.com/pkgs/main || true
$MINICONDA_ROOT/bin/conda tos accept --override-channels \
    --channel https://repo.anaconda.com/pkgs/r || true

$MINICONDA_ROOT/bin/conda create -y -p $ENV_PATH python=3.10

source $MINICONDA_ROOT/etc/profile.d/conda.sh
conda activate $ENV_PATH

pip install torch==2.1.0 torchvision==0.16.0 torchaudio==2.1.0 \
    --index-url https://download.pytorch.org/whl/cu121

pip install \
    numpy \
    Pillow \
    tqdm \
    scipy \
    matplotlib \
    scikit-image \
    lpips \
    opencv-python \
    plyfile \
    joblib

python3 -c "
import torch
print('PyTorch:', torch.__version__)
print('CUDA available:', torch.cuda.is_available())
print('CUDA version:', torch.version.cuda)
print('GPU:', torch.cuda.get_device_name(0))
print('VRAM (GB):', round(torch.cuda.get_device_properties(0).total_memory / 1e9, 1))
"

conda env export -p $ENV_PATH > /home/arua/thesis/environment_pre_build.yml
pip freeze > /home/arua/thesis/requirements_pre_build.txt

echo "env build done"